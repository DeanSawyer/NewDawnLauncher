<?xml version="1.0" encoding="UTF-8" ?>
<UserControl x:Class="Launcher.Views.Server"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:m="using:Launcher.Models"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             xmlns:vm="using:Launcher.ViewModels"
             d:DesignHeight="550"
             d:DesignWidth="650"
             x:DataType="vm:Server"
             mc:Ignorable="d">

  <Design.DataContext>
    <vm:Server />
  </Design.DataContext>

  <!-- New Dawn single-realm landing screen. The PlayCommand retains upstream game launch behavior. -->
  <Grid RowDefinitions="*,Auto,Auto,*">
    <!-- Layered wordmark gives the original two-line branding depth without changing the background. -->
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
      <Border Width="390" Height="1" Background="#88D9EFFF" Margin="0,0,0,8" />

      <Grid HorizontalAlignment="Center">
        <TextBlock Text="FREE REALMS" FontFamily="avares://Launcher/Assets/Fonts#FreeRealmsDemiBold"
                   FontSize="46" FontWeight="Normal" Foreground="#C0081325"
                   Margin="2,4,0,0" TextAlignment="Center" HorizontalAlignment="Center" />
        <TextBlock Text="FREE REALMS" FontFamily="avares://Launcher/Assets/Fonts#FreeRealmsDemiBold"
                   FontSize="46" FontWeight="Normal" TextAlignment="Center" HorizontalAlignment="Center">
          <TextBlock.Foreground>
            <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
              <GradientStop Offset="0" Color="#FFFDF0D5"/>
              <GradientStop Offset="0.48" Color="#FFF2D695"/>
              <GradientStop Offset="1" Color="#FFD29D50"/>
            </LinearGradientBrush>
          </TextBlock.Foreground>
        </TextBlock>
      </Grid>

      <Grid HorizontalAlignment="Center" Margin="0,-5,0,0">
        <TextBlock Text="NEW DAWN" FontFamily="avares://Launcher/Assets/Fonts#FreeRealmsDemiBold"
                   FontSize="34" FontWeight="Normal" Foreground="#DB061B34"
                   Margin="2,4,0,0" TextAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Text="NEW DAWN" FontFamily="avares://Launcher/Assets/Fonts#FreeRealmsDemiBold"
                   FontSize="34" FontWeight="Normal" TextAlignment="Center" HorizontalAlignment="Center">
          <TextBlock.Foreground>
            <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
              <GradientStop Offset="0" Color="#FFFFFFFF"/>
              <GradientStop Offset="0.45" Color="#FFDAF5FF"/>
              <GradientStop Offset="1" Color="#FF7AC7F2"/>
            </LinearGradientBrush>
          </TextBlock.Foreground>
        </TextBlock>
      </Grid>

      <Border Background="#A00B2439" BorderBrush="#6688C9F6" BorderThickness="1"
              CornerRadius="8" Padding="12,4" HorizontalAlignment="Center" Margin="0,9,0,0">
        <TextBlock Text="{Binding Info.Name, Mode=OneWay}" FontSize="13"
                   Foreground="#E7F3F9" HorizontalAlignment="Center" />
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="0,22,0,0" HorizontalAlignment="Center" Spacing="12">
      <Border HorizontalAlignment="Center" CornerRadius="14" BorderThickness="2" BorderBrush="#A9EDB4"
              BoxShadow="0 0 20 2 #5503E860">
        <Button Width="300" Height="72"
                Command="{Binding PlayCommand}"
                IsEnabled="{Binding IsEnabled}"
                Cursor="Hand" CornerRadius="12"
                FontSize="30" FontWeight="Bold"
                Foreground="White" Content="Play Now!">
          <!-- Explicit template prevents global transparent button styles from hiding the fill. -->
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border CornerRadius="12" BorderThickness="1" BorderBrush="#B4F9BB">
                <Border.Background>
                  <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                    <GradientStop Offset="0" Color="#86E47B"/>
                    <GradientStop Offset="0.46" Color="#31BC45"/>
                    <GradientStop Offset="1" Color="#087028"/>
                  </LinearGradientBrush>
                </Border.Background>
                <ContentPresenter Content="{TemplateBinding Content}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Border>
      <TextBlock Text="{Binding StatusMessage, Mode=OneWay}"
                 Foreground="#E9F4F9" FontSize="13"
                 HorizontalAlignment="Center"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
        <Button Command="{Binding OpenFolderCommand}" Content="Open Folder" Background="#C821496F" Foreground="White" CornerRadius="8" Padding="16,8" />
        <Button Command="{Binding RefreshCommand}" Content="Refresh" Background="#C821496F" Foreground="White" CornerRadius="8" Padding="16,8" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>