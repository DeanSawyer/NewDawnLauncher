<?xml version="1.0" encoding="UTF-8" ?>
<UserControl x:Class="Launcher.Views.Server"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:m="using:Launcher.Models"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             xmlns:vm="using:Launcher.ViewModels"
             d:DesignHeight="550"
             d:DesignWidth="650"
             x:DataType="vm:Server"
             mc:Ignorable="d">

  <Design.DataContext>
    <vm:Server />
  </Design.DataContext>

  <!-- New Dawn single-realm landing screen. The PlayCommand retains upstream game launch behavior. -->
  <Grid RowDefinitions="*,Auto,Auto,*">
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
      <TextBlock Text="FREE REALMS" FontSize="40" FontWeight="Bold"
                 Foreground="#F1E0BC" TextAlignment="Center"
                 HorizontalAlignment="Center" />
      <TextBlock Text="NEW DAWN" FontSize="32" FontWeight="Bold"
                 Foreground="#D3F0FF" TextAlignment="Center"
                 HorizontalAlignment="Center" />
      <Border Background="#700B2439" CornerRadius="8" Padding="12,4" HorizontalAlignment="Center">
        <TextBlock Text="{Binding Info.Name, Mode=OneWay}" FontSize="13"
                   Foreground="#E7F3F9" HorizontalAlignment="Center" />
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="0,32,0,0" HorizontalAlignment="Center" Spacing="12">
      <Border CornerRadius="14" BorderThickness="2" BorderBrush="#B2D6B0"
              BoxShadow="0 0 20 2 #5503E860">
        <Button Width="300" Height="72"
                Command="{Binding PlayCommand}"
                IsEnabled="{Binding IsEnabled}"
                Cursor="Hand" CornerRadius="12"
                FontSize="30" FontWeight="Bold"
                Foreground="White" Content="Play Now!">
          <Button.Background>
            <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
              <GradientStop Offset="0" Color="#96E97D"/>
              <GradientStop Offset="0.45" Color="#26B83B"/>
              <GradientStop Offset="1" Color="#075620"/>
            </LinearGradientBrush>
          </Button.Background>
        </Button>
      </Border>
      <TextBlock Text="{Binding StatusMessage, Mode=OneWay}"
                 Foreground="#E9F4F9" FontSize="13"
                 HorizontalAlignment="Center"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
        <Button Command="{Binding OpenFolderCommand}" Content="Open Folder" />
        <Button Command="{Binding RefreshCommand}" Content="Refresh" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>